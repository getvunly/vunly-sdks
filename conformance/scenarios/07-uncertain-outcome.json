{
  "id": "uncertain-outcome",
  "title": "The server commits, the response is lost, the client retries with the SAME id: exactly one effect",
  "setup": [
    {
      "name": "meter",
      "http": {
        "method": "POST",
        "path": "/v1/meters",
        "body": { "key": "tokens", "unitsPerCredit": 1000 }
      },
      "expect": { "status": [200, 201] }
    },
    {
      "name": "plan",
      "http": {
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "key": "starter-{{run}}",
          "name": "Starter",
          "includedCredits": 100,
          "meter": "tokens",
          "features": ["generate"]
        }
      },
      "expect": { "status": [200, 201] }
    },
    {
      "name": "customer",
      "http": {
        "method": "POST",
        "path": "/v1/customers",
        "body": { "externalId": "cus-{{run}}" }
      },
      "expect": { "status": [200, 201] }
    },
    {
      "name": "subscribe",
      "http": {
        "method": "POST",
        "path": "/v1/customers/cus-{{run}}/subscription",
        "body": { "plan": "starter-{{run}}" }
      },
      "expect": { "status": [200, 201] }
    }
  ],
  "steps": [
    {
      "name": "the ledger starts with the plan's grant only",
      "as": "admin",
      "http": { "method": "GET", "path": "/v1/customers/cus-{{run}}/ledger" },
      "expect": { "status": 200, "body": { "data": ["$any"] } }
    },

    {
      "name": "arm: the next usage answer is committed by the server and lost on the way back",
      "fault": { "match": "POST /v1/usage-events", "dropResponse": 1 }
    },
    {
      "name": "the SDK retries by itself with the same id and learns the original result",
      "op": "usage.record",
      "retries": true,
      "input": {
        "id": "lost-{{run}}-1",
        "customer": "cus-{{run}}",
        "meter": "tokens",
        "quantity": 3000
      },
      "expect": {
        "ok": { "remaining": 97, "replayed": true, "event": { "kind": "debit", "credits": -3 } }
      }
    },
    {
      "name": "one debit, not two",
      "op": "credits.balance",
      "input": { "customer": "cus-{{run}}" },
      "expect": { "ok": { "remaining": 97, "consumed": 3, "granted": 100 } }
    },
    {
      "name": "one ledger row for it",
      "as": "admin",
      "http": { "method": "GET", "path": "/v1/customers/cus-{{run}}/ledger" },
      "expect": { "status": 200, "body": { "data": ["$any", "$any"] } }
    },

    { "name": "arm again", "fault": { "match": "POST /v1/usage-events", "dropResponse": 1 } },
    {
      "name": "with retries off a lost response is Unavailable: the caller does not know",
      "op": "usage.record",
      "input": {
        "id": "lost-{{run}}-2",
        "customer": "cus-{{run}}",
        "meter": "tokens",
        "quantity": 3000
      },
      "expect": { "error": { "class": "Unavailable" } }
    },
    {
      "name": "asking again with the SAME id reveals it was applied: a replay",
      "op": "usage.record",
      "input": {
        "id": "lost-{{run}}-2",
        "customer": "cus-{{run}}",
        "meter": "tokens",
        "quantity": 3000
      },
      "expect": { "ok": { "remaining": 94, "replayed": true } }
    },
    {
      "name": "still one debit for it",
      "op": "credits.balance",
      "input": { "customer": "cus-{{run}}" },
      "expect": { "ok": { "remaining": 94, "consumed": 6, "granted": 100 } }
    },

    {
      "name": "arm a lost credit grant",
      "fault": { "match": "POST /v1/customers/cus-{{run}}/credit-grants", "dropResponse": 1 }
    },
    {
      "name": "the SDK retries the grant with the same id",
      "op": "credits.grant",
      "retries": true,
      "input": { "id": "lostg-{{run}}-1", "customer": "cus-{{run}}", "credits": 10 },
      "expect": { "ok": { "kind": "grant", "credits": 10 } }
    },
    {
      "name": "granted once",
      "op": "credits.balance",
      "input": { "customer": "cus-{{run}}" },
      "expect": { "ok": { "remaining": 104, "consumed": 6, "granted": 110 } }
    },

    {
      "name": "a retry that arrives while the first request is still in flight: four at once, one debit",
      "parallel": [
        {
          "op": "usage.record",
          "input": {
            "id": "inflight-{{run}}-1",
            "customer": "cus-{{run}}",
            "meter": "tokens",
            "quantity": 1000
          }
        },
        {
          "op": "usage.record",
          "input": {
            "id": "inflight-{{run}}-1",
            "customer": "cus-{{run}}",
            "meter": "tokens",
            "quantity": 1000
          }
        },
        {
          "op": "usage.record",
          "input": {
            "id": "inflight-{{run}}-1",
            "customer": "cus-{{run}}",
            "meter": "tokens",
            "quantity": 1000
          }
        },
        {
          "op": "usage.record",
          "input": {
            "id": "inflight-{{run}}-1",
            "customer": "cus-{{run}}",
            "meter": "tokens",
            "quantity": 1000
          }
        }
      ],
      "counts": { "ok": 4, "error": 0 }
    },
    {
      "name": "one more debit only",
      "op": "credits.balance",
      "input": { "customer": "cus-{{run}}" },
      "expect": { "ok": { "remaining": 103, "consumed": 7, "granted": 110 } }
    },
    {
      "name": "and one more ledger row: plan grant, 2 lost-and-retried debits, the lost grant, the in-flight debit",
      "as": "admin",
      "http": { "method": "GET", "path": "/v1/customers/cus-{{run}}/ledger" },
      "expect": { "status": 200, "body": { "data": ["$any", "$any", "$any", "$any", "$any"] } }
    }
  ]
}
