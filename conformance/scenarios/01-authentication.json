{
  "id": "authentication",
  "title": "Credentials: a missing, unknown or under-scoped key is refused with a stable code; nothing is done",
  "setup": [
    {
      "name": "meter",
      "http": {
        "method": "POST",
        "path": "/v1/meters",
        "body": { "key": "tokens", "unitsPerCredit": 1000 }
      },
      "expect": { "status": [200, 201] }
    },
    {
      "name": "customer",
      "http": {
        "method": "POST",
        "path": "/v1/customers",
        "body": { "externalId": "cus-{{run}}" }
      },
      "expect": { "status": [200, 201] }
    }
  ],
  "steps": [
    {
      "name": "a valid key works",
      "op": "customers.upsert",
      "as": "app",
      "input": { "id": "cus-{{run}}" },
      "expect": { "ok": { "externalId": "cus-{{run}}", "id": "$string" } }
    },
    {
      "name": "an unknown key is unauthenticated",
      "op": "customers.upsert",
      "as": "bogus",
      "input": { "id": "cus-{{run}}" },
      "expect": { "error": { "class": "AuthError", "status": 401, "code": "unauthenticated" } }
    },
    {
      "name": "no credential at all is unauthenticated",
      "as": "none",
      "http": { "method": "GET", "path": "/v1/customers" },
      "expect": {
        "status": 401,
        "body": {
          "error": { "code": "unauthenticated", "message": "$string", "requestId": "$string" }
        }
      }
    },
    {
      "name": "a key without the scope is refused (usage:write)",
      "op": "usage.record",
      "as": "limited",
      "input": {
        "id": "scope-{{run}}-1",
        "customer": "cus-{{run}}",
        "meter": "tokens",
        "quantity": 1
      },
      "expect": { "error": { "class": "AuthError", "status": 403, "code": "missing_scope" } }
    },
    {
      "name": "a key without the scope is refused (balance:read)",
      "op": "credits.balance",
      "as": "limited",
      "input": { "customer": "cus-{{run}}" },
      "expect": { "error": { "class": "AuthError", "status": 403, "code": "missing_scope" } }
    },
    {
      "name": "the refused call changed nothing",
      "op": "credits.balance",
      "as": "app",
      "input": { "customer": "cus-{{run}}" },
      "expect": { "ok": { "remaining": 0, "consumed": 0, "granted": 0 } }
    }
  ]
}
