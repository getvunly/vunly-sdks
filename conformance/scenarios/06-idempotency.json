{
  "id": "idempotency",
  "title": "Idempotency: concurrent and repeated requests with one id change the ledger once",
  "setup": [
    {
      "name": "meter",
      "http": {
        "method": "POST",
        "path": "/v1/meters",
        "body": {
          "key": "tokens",
          "unitsPerCredit": 1000
        }
      },
      "expect": {
        "status": [200, 201]
      }
    },
    {
      "name": "customer",
      "http": {
        "method": "POST",
        "path": "/v1/customers",
        "body": {
          "externalId": "cus-{{run}}"
        }
      },
      "expect": {
        "status": [200, 201]
      }
    },
    {
      "name": "funds",
      "http": {
        "method": "POST",
        "path": "/v1/customers/cus-{{run}}/credit-grants",
        "headers": {
          "idempotency-key": "fund-{{run}}-0001"
        },
        "body": {
          "credits": 100
        }
      },
      "expect": {
        "status": [200, 201]
      }
    }
  ],
  "steps": [
    {
      "name": "five concurrent records with one id",
      "parallel": [
        {
          "op": "usage.record",
          "input": {
            "id": "same-{{run}}-1",
            "customer": "cus-{{run}}",
            "meter": "tokens",
            "quantity": 3000
          },
          "expect": {
            "ok": {
              "remaining": 97
            }
          }
        },
        {
          "op": "usage.record",
          "input": {
            "id": "same-{{run}}-1",
            "customer": "cus-{{run}}",
            "meter": "tokens",
            "quantity": 3000
          },
          "expect": {
            "ok": {
              "remaining": 97
            }
          }
        },
        {
          "op": "usage.record",
          "input": {
            "id": "same-{{run}}-1",
            "customer": "cus-{{run}}",
            "meter": "tokens",
            "quantity": 3000
          },
          "expect": {
            "ok": {
              "remaining": 97
            }
          }
        },
        {
          "op": "usage.record",
          "input": {
            "id": "same-{{run}}-1",
            "customer": "cus-{{run}}",
            "meter": "tokens",
            "quantity": 3000
          },
          "expect": {
            "ok": {
              "remaining": 97
            }
          }
        },
        {
          "op": "usage.record",
          "input": {
            "id": "same-{{run}}-1",
            "customer": "cus-{{run}}",
            "meter": "tokens",
            "quantity": 3000
          },
          "expect": {
            "ok": {
              "remaining": 97
            }
          }
        }
      ]
    },
    {
      "name": "the ledger debited once",
      "op": "credits.balance",
      "input": {
        "customer": "cus-{{run}}"
      },
      "expect": {
        "ok": {
          "remaining": 97,
          "consumed": 3,
          "granted": 100
        }
      }
    },
    {
      "name": "five concurrent grants with one id",
      "parallel": [
        {
          "op": "credits.grant",
          "input": {
            "id": "gsame-{{run}}-1",
            "customer": "cus-{{run}}",
            "credits": 10
          },
          "expect": {
            "ok": {
              "credits": 10
            }
          }
        },
        {
          "op": "credits.grant",
          "input": {
            "id": "gsame-{{run}}-1",
            "customer": "cus-{{run}}",
            "credits": 10
          },
          "expect": {
            "ok": {
              "credits": 10
            }
          }
        },
        {
          "op": "credits.grant",
          "input": {
            "id": "gsame-{{run}}-1",
            "customer": "cus-{{run}}",
            "credits": 10
          },
          "expect": {
            "ok": {
              "credits": 10
            }
          }
        },
        {
          "op": "credits.grant",
          "input": {
            "id": "gsame-{{run}}-1",
            "customer": "cus-{{run}}",
            "credits": 10
          },
          "expect": {
            "ok": {
              "credits": 10
            }
          }
        },
        {
          "op": "credits.grant",
          "input": {
            "id": "gsame-{{run}}-1",
            "customer": "cus-{{run}}",
            "credits": 10
          },
          "expect": {
            "ok": {
              "credits": 10
            }
          }
        }
      ]
    },
    {
      "name": "granted once",
      "op": "credits.balance",
      "input": {
        "customer": "cus-{{run}}"
      },
      "expect": {
        "ok": {
          "remaining": 107,
          "granted": 110
        }
      }
    },
    {
      "name": "concurrent DIFFERENT ids that together exceed the balance: never overdrawn",
      "parallel": [
        {
          "op": "usage.record",
          "input": {
            "id": "race-{{run}}-1",
            "customer": "cus-{{run}}",
            "meter": "tokens",
            "quantity": 100000
          }
        },
        {
          "op": "usage.record",
          "input": {
            "id": "race-{{run}}-2",
            "customer": "cus-{{run}}",
            "meter": "tokens",
            "quantity": 100000
          }
        }
      ],
      "counts": {
        "ok": 1,
        "error": 1
      },
      "errorExpect": {
        "class": "LimitReached",
        "status": 402,
        "code": "insufficient_credits"
      }
    },
    {
      "name": "the balance never went negative",
      "op": "credits.balance",
      "input": {
        "customer": "cus-{{run}}"
      },
      "expect": {
        "ok": {
          "remaining": 7
        }
      }
    }
  ]
}
