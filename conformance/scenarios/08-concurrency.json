        {
          "op": "usage.record",
          "timeoutMs": 60000,
          "input": {
            "id": "c-{{run}}-20",
            "customer": "cus-{{run}}",
            "meter": "tokens",
            "quantity": 1000
          }
        }
      ],
      "counts": { "ok": 5, "error": 15 },
      "errorExpect": { "class": "LimitReached", "status": 402, "code": "insufficient_credits" }
    },
    {
      "name": "exactly five credits spent, none left, never negative",
      "op": "credits.balance",
      "input": { "customer": "cus-{{run}}" },
      "expect": { "ok": { "remaining": 0, "consumed": 5, "granted": 5 } }
    },
    {
      "name": "exactly five debit rows besides the grant",
      "as": "admin",
      "http": { "method": "GET", "path": "/v1/customers/cus-{{run}}/ledger" },
      "expect": {
        "status": 200,
        "body": { "data": ["$any", "$any", "$any", "$any", "$any", "$any"] }
      }
    }
  ]
}
