{
  "id": "timeouts-and-rate-limits",
  "title": "A timeout after the server committed is retried with the same id (one debit); a 429 is waited out for Retry-After, then retried; an absurd Retry-After is not waited for",
  "setup": [
    {
      "name": "meter",
      "http": {
        "method": "POST",
        "path": "/v1/meters",
        "body": { "key": "tokens", "unitsPerCredit": 1000 }
      },
      "expect": { "status": [200, 201] }
    },
    {
      "name": "plan",
      "http": {
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "key": "starter-{{run}}",
          "name": "Starter",
          "includedCredits": 100,
          "meter": "tokens",
          "features": ["generate"]
        }
      },
      "expect": { "status": [200, 201] }
    },
    {
      "name": "customer",
      "http": {
        "method": "POST",
        "path": "/v1/customers",
        "body": { "externalId": "cus-{{run}}" }
      },
      "expect": { "status": [200, 201] }
    },
    {
      "name": "subscribe",
      "http": {
        "method": "POST",
        "path": "/v1/customers/cus-{{run}}/subscription",
        "body": { "plan": "starter-{{run}}" }
      },
      "expect": { "status": [200, 201] }
    }
  ],
  "steps": [
    {
      "name": "arm: the server commits, then holds the answer until the client gives up (60 s at most)",
      "fault": { "match": "POST /v1/usage-events", "delayMs": 60000, "times": 1 }
    },
    {
      "name": "the SDK times out and retries with the same id: it learns the original result",
      "op": "usage.record",
      "retries": true,
      "timeoutMs": 4000,
      "input": {
        "id": "slow-{{run}}-1",
        "customer": "cus-{{run}}",
        "meter": "tokens",
        "quantity": 3000
      },
      "expect": { "ok": { "remaining": 97, "replayed": true } }
    },
    {
      "name": "one debit for the timed-out request",
      "op": "credits.balance",
      "input": { "customer": "cus-{{run}}" },
      "expect": { "ok": { "remaining": 97, "consumed": 3, "granted": 100 } }
    },

    {
      "name": "arm: the next request is answered 429 with Retry-After: 1 and nothing is done",
      "fault": { "match": "POST /v1/usage-events", "status": 429, "retryAfter": 1, "times": 1 }
    },
    {
      "name": "the SDK waits Retry-After, then retries with the same id and succeeds the first time",
      "op": "usage.record",
      "retries": true,
      "minElapsedMs": 900,
      "input": {
        "id": "limited-{{run}}-1",
        "customer": "cus-{{run}}",
        "meter": "tokens",
        "quantity": 3000
      },
      "expect": { "ok": { "remaining": 94, "replayed": false } }
    },
    {
      "name": "one debit for it",
      "op": "credits.balance",
      "input": { "customer": "cus-{{run}}" },
      "expect": { "ok": { "remaining": 94, "consumed": 6, "granted": 100 } }
    },

    {
      "name": "arm: 429 with Retry-After: 3600",
      "fault": { "match": "POST /v1/usage-events", "status": 429, "retryAfter": 3600, "times": 1 }
    },
    {
      "name": "a Retry-After longer than 30 s is not waited for: Unavailable at once",
      "op": "usage.record",
      "retries": true,
      "maxElapsedMs": 20000,
      "input": {
        "id": "limited-{{run}}-2",
        "customer": "cus-{{run}}",
        "meter": "tokens",
        "quantity": 3000
      },
      "expect": { "error": { "class": "Unavailable", "status": 429, "code": "rate_limited" } }
    },
    {
      "name": "arm: 429 with Retry-After: 1e999 (a number no float can hold)",
      "fault": {
        "match": "POST /v1/usage-events",
        "status": 429,
        "retryAfter": "1e999",
        "times": 1
      }
    },
    {
      "name": "an unrepresentable Retry-After is a very long one, not an absent one: Unavailable at once, never an early retry",
      "op": "usage.record",
      "retries": true,
      "maxElapsedMs": 20000,
      "input": {
        "id": "limited-{{run}}-3",
        "customer": "cus-{{run}}",
        "meter": "tokens",
        "quantity": 3000
      },
      "expect": { "error": { "class": "Unavailable", "status": 429, "code": "rate_limited" } }
    },
    {
      "name": "arm: 429 with a 517-digit Retry-After",
      "fault": {
        "match": "POST /v1/usage-events",
        "status": 429,
        "retryAfter": "",
        "times": 1
      }
    },
    {
      "name": "a 517-digit Retry-After is also surfaced at once",
      "op": "usage.record",
      "retries": true,
      "maxElapsedMs": 20000,
      "input": {
        "id": "limited-{{run}}-4",
        "customer": "cus-{{run}}",
        "meter": "tokens",
        "quantity": 3000
      },
      "expect": { "error": { "class": "Unavailable", "status": 429, "code": "rate_limited" } }
    },
    {
      "name": "nothing was debited",
      "op": "credits.balance",
      "input": { "customer": "cus-{{run}}" },
      "expect": { "ok": { "remaining": 94, "consumed": 6 } }
    },
    {
      "name": "the same id works once the limit is gone",
      "op": "usage.record",
      "input": {
        "id": "limited-{{run}}-2",
        "customer": "cus-{{run}}",
        "meter": "tokens",
        "quantity": 3000
      },
      "expect": { "ok": { "remaining": 91, "replayed": false } }
    }
  ]
}
