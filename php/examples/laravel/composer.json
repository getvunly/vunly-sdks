{
  "name": "vunly/example-laravel",
  "description": "A minimal Laravel application that meters its own work with Vunly: service provider (auto-discovered), facade and middleware.",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0 || ^13.0",
    "vunly/vunly": "0.1.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../..",
      "options": {
        "symlink": false,
        "versions": {
          "vunly/vunly": "0.1.0"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "preferred-install": "dist"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
