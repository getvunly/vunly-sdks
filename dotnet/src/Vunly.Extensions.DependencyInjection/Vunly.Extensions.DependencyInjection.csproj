<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Microsoft.Extensions.DependencyInjection</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- The package id is local, as for Vunly: this SDK is not published to a package registry. -->
    <PackageId>Vunly.Extensions.DependencyInjection</PackageId>
    <Version>0.1.0</Version>
    <Title>Vunly .NET SDK: dependency injection</Title>
    <Description>AddVunly(): registers the Vunly client with Microsoft.Extensions.DependencyInjection, IHttpClientFactory and options validation.</Description>
    <Authors>Vunly</Authors>
    <Company>Vunly</Company>
    <Copyright>Copyright 2026 Vunly</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/getvunly/vunly-sdks</PackageProjectUrl>
    <RepositoryUrl>https://github.com/getvunly/vunly-sdks</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>vunly;billing;usage;metering;dependency-injection</PackageTags>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vunly\Vunly.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
