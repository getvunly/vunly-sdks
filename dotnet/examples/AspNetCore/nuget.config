<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- The packages are not published: the SDK comes from the `artifacts` folder of the dotnet directory, which
         `dotnet pack -o artifacts` writes to (see the README of the dotnet directory). -->
    <add key="vunly-local" value="../../artifacts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- The package ids "Vunly" and "Vunly.*" are not reserved on nuget.org: anyone could register them there. Source mapping makes
       a package with that name come from the local folder and from nowhere else (dependency confusion); everything else
       comes from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="vunly-local">
      <package pattern="Vunly" />
      <package pattern="Vunly.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
